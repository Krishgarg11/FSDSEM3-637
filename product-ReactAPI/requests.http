@baseUrl = http://localhost:4000

### API info
GET {{baseUrl}}/

### GET all products
GET {{baseUrl}}/products

### GET one product
GET {{baseUrl}}/products/1

### POST a new product
POST {{baseUrl}}/products
Content-Type: application/json

{
  "name": "Mechanical Keyboard",
  "category": "Electronics",
  "price": 4999,
  "stock": 15
}

### PUT (replace) a product
PUT {{baseUrl}}/products/1
Content-Type: application/json

{
  "name": "Wireless Keyboard Pro",
  "category": "Electronics",
  "price": 1999,
  "stock": 30
}

### PATCH only the stock
PATCH {{baseUrl}}/products/1
Content-Type: application/json

{
  "stock": 45
}

### DELETE a product
DELETE {{baseUrl}}/products/9

### GET the deleted product (should return 404)
GET {{baseUrl}}/products/9

### Invalid product (should return 400)
POST {{baseUrl}}/products
Content-Type: application/json

{
  "name": "No category price or stock"
}
